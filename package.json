{
  "name": "academia-premium",
  "version": "1.0.0",
  "private": true,
  "description": "Site premium para academia - Next.js (export estático) + Tailwind + Framer Motion, pronto para Cloudflare Pages",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "preview": "wrangler pages dev out",
    "deploy": "npm run build && wrangler pages deploy out --project-name=academia-premium"
  },
  "dependencies": {
    "framer-motion": "^12.0.0",
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  },
  "engines": { "node": ">=20" }
}
